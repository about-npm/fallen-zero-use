{
  "compilerOptions": {
    "jsx": "preserve",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "target": "es2016",
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".*/"
  ]
}